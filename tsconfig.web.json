{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "none",
    "outFile": "public/dashboard.js",
    "strict": true,
    "noEmitOnError": true,
    "noImplicitOverride": true,
    "removeComments": false,
    "skipLibCheck": true
  },
  "include": ["web/**/*.ts"]
}

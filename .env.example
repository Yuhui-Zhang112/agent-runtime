# agent-runtime · 环境变量

# ── 方案 A：Anthropic（推荐，prompt cache / thinking 特性完整）──────────
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com   # 走中转时改这个

# ── 方案 B：任意 OpenAI 兼容接口 ──────────────────────────────────────
# DeepSeek
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# 通义千问
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# 智谱
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4.6

# 本地 vLLM / Ollama
# OPENAI_API_KEY=local
# OPENAI_BASE_URL=http://127.0.0.1:8000/v1
# LLM_MODEL=Qwen2.5-Coder-7B-Instruct

# ── 服务端（npm run serve）────────────────────────────────────────────
# 下面这些只在跑服务时需要，npm run dev 用不到
#
# PROVIDER=openai            # anthropic | openai
# API_KEY=sk-...             # 必填，服务启动时会自检
# BASE_URL=https://api.deepseek.com/v1
# MODEL=deepseek-chat
#
# PORT=8787
# HOST=127.0.0.1             # 想对外暴露就必须同时设 AUTH_TOKEN，否则启动报错
# AUTH_TOKEN=                # 调用方需带 Authorization: Bearer <token>
#
# CWD=                       # 工具的工作根目录，所有文件操作锁在里面。默认当前目录
# SYSTEM_PROMPT=             # 覆盖默认系统提示词
# MAX_TURNS=20
# MAX_PARALLEL=8
#
# SESSION_BUDGET_USD=1       # 单会话成本上限，超出即熔断 —— 防止死循环烧钱
# MAX_CONCURRENT_RUNS=4      # 全局并发上限
# MAX_BODY_BYTES=1000000     # 单请求体上限（字节）
# SESSION_IDLE_TTL_MS=1800000
#
# LOG_DIR=./logs             # 结构化日志（JSONL）落盘目录。不设 = 只记内存
#
# ── 权限系统（Phase 2）────────────────────────────────────────────────
# PERMISSION_MODE=default    # default | plan | acceptEdits | bypassPermissions
#                            # default: 只读放行，写/执行要批准
#                            # plan: 只许看；acceptEdits: 自动放行写文件
#                            # bypassPermissions: 跳过询问（危险命令硬约束仍生效）
# PERMISSION_RULES='[{"tool":"Bash","action":"allow","pattern":"npm *"}]'
#                            # JSON 数组，pattern 为 glob。deny 优先于 allow
# APPROVAL_TIMEOUT_MS=60000  # 审批等待上限，超时按拒绝（fail-closed）
#
# ── 上下文压缩（Phase 3）─────────────────────────────────────────────
# COMPACTION=on              # on | off。off = 完全不压缩（A/B 实验的基线组）
# COMPACTION_TRIGGER_TOKENS=6000   # 上下文超过这个数才考虑压缩
# COMPACTION_TARGET_TOKENS=3000    # 压到这个预算就收手；只给 trigger 时自动取一半
# COMPACTION_PROTECT_RECENT=4      # 末尾 N 条消息绝对不动
# COMPACTION_MIN_RESULT_CHARS=600  # 单条工具结果短于这个就不值得压
# COMPACTION_RECOVERABLE=true      # 占位符是否写明「可重新 Read 取回」
#                                  # 关掉会变成「不可恢复」退化策略：更省，但会丢失精确引用
# TRACE_DIR=./traces         # 每轮 Trace 的 JSONL 落盘目录。不设 = 只记内存
#                            # 压缩事件、token、成本都在这里，重启也能回放
#
# 提示：换任务集后建议重跑 `npm run eval:compaction`，按 reports/ 里的
#       参数扫描曲线重新定上面这几个值，别直接抄默认值。
